---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllSurahs, getSurahMeta, getSurahTafsir, hasPdf } from '../../../lib/content.js';

export function getStaticPaths() {
  const surahs = getAllSurahs();
  return surahs.map(s => ({
    params: { slug: s.slug },
    props: { surahNumber: s.number },
  }));
}

const { surahNumber } = Astro.props;
const meta = getSurahMeta(surahNumber);
const allSurahs = getAllSurahs();
const surahInfo = allSurahs.find(s => s.number === surahNumber);
const verses = getSurahTafsir(surahNumber);
const pdfExists = hasPdf(surahNumber);
const pdfNum = String(surahNumber).padStart(3, '0');

const statusColors = {
  draft: 'badge-draft',
  review: 'badge-review',
  scheduled: 'badge-scheduled',
  published: 'badge-published',
};
const statusLabels = {
  draft: 'Brouillon',
  review: 'En relecture',
  scheduled: 'Planifiee',
  published: 'Publiee',
};

// Navigation: prev/next
const prevSurah = surahNumber > 1 ? allSurahs.find(s => s.number === surahNumber - 1) : null;
const nextSurah = surahNumber < 114 ? allSurahs.find(s => s.number === surahNumber + 1) : null;
---

<BaseLayout title={`Relecture - ${meta.name_fr}`}>
  <div class="container-wide">
    <!-- Breadcrumb + nav -->
    <div style="padding: 1rem 0; font-size: 0.9rem; color: var(--color-text-muted); display: flex; justify-content: space-between; align-items: center;">
      <div>
        <a href="/admin/">Gestion</a> &raquo; Relecture &raquo; Sourate {surahNumber}
      </div>
      <div style="display: flex; gap: 1rem;">
        {prevSurah && <a href={`/admin/review/${prevSurah.slug}/`}>&larr; {prevSurah.name_fr}</a>}
        {nextSurah && <a href={`/admin/review/${nextSurah.slug}/`}>{nextSurah.name_fr} &rarr;</a>}
      </div>
    </div>

    <!-- Surah info panel -->
    <div style="background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h1 style="font-size: 1.6rem; margin-bottom: 0.25rem;">
            Sourate {meta.number} - {meta.name_fr}
          </h1>
          <div style="font-family: var(--font-arabic); font-size: 1.5rem; direction: rtl; color: var(--color-primary);">
            {meta.name_ar}
          </div>
        </div>
        <div style="text-align: right;">
          <span class={`badge ${statusColors[surahInfo.status] || 'badge-draft'}`} id="surah-status-badge">
            {statusLabels[surahInfo.status] || surahInfo.status}
          </span>
          <div style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--color-text-muted);">
            {verses.length}/{meta.verses} versets &middot; {meta.type}
          </div>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="validation-progress" style="margin-top: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <span style="font-size: 0.9rem; font-weight: 600;">Progression de la validation</span>
          <span id="progress-text" style="font-size: 0.85rem; color: var(--color-text-muted);">Chargement...</span>
        </div>
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" id="progress-bar" style="width: 0%;"></div>
        </div>
        <div id="error-count-bar" style="display: none; margin-top: 0.5rem; font-size: 0.85rem; color: #dc2626;">
          <span id="error-count-text"></span>
        </div>
      </div>

      <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); display: flex; gap: 2rem; flex-wrap: wrap; font-size: 0.9rem;">
        <div><strong>Relecteur :</strong> {surahInfo.reviewer || 'Non assigne'}</div>
        <div><strong>Derniere relecture :</strong> {surahInfo.last_reviewed || 'Jamais'}</div>
        <div><strong>Publication prevue :</strong> {surahInfo.publish_date || 'Non planifiee'}</div>
        {pdfExists && (
          <div><strong>PDF de reference :</strong> <a href={`/pdf/${pdfNum}.pdf`} target="_blank">Ouvrir le PDF</a></div>
        )}
      </div>

      {surahInfo.notes && (
        <div style="margin-top: 0.75rem; padding: 0.75rem; background: #f0f9ff; border-radius: 6px; font-size: 0.9rem;">
          <strong>Notes :</strong> {surahInfo.notes}
        </div>
      )}
    </div>

    <!-- Layout: PDF + Tafsir side by side -->
    <div class="review-layout">
      {pdfExists && (
        <div class="review-pdf">
          <h2 style="font-size: 1.1rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-border);">
            PDF de reference
          </h2>
          <iframe src={`/pdf/${pdfNum}.pdf#toolbar=0&navpanes=0&view=FitH`} style="width: 100%; height: 85vh; border: 1px solid var(--color-border); border-radius: 8px;"></iframe>
        </div>
      )}

      <div class="review-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-border); flex-wrap: wrap; gap: 0.5rem;">
          <h2 style="font-size: 1.1rem;">
            Tafsir JSON ({verses.length} versets)
          </h2>
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div class="tts-controls">
              <button id="tts-play-all" class="tts-btn tts-btn-main" title="Lire tous les versets">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                Tout ecouter
              </button>
              <div class="tts-speed-control">
                <label for="tts-speed" style="font-size: 0.75rem; color: var(--color-text-muted);">Vitesse</label>
                <select id="tts-speed" class="tts-speed-select">
                  <option value="0.7">0.7x</option>
                  <option value="0.85">0.85x</option>
                  <option value="1" selected>1x</option>
                  <option value="1.15">1.15x</option>
                  <option value="1.3">1.3x</option>
                  <option value="1.5">1.5x</option>
                </select>
              </div>
            </div>
            <div style="font-size: 0.85rem; color: var(--color-text-muted);">
              5 votes requis
            </div>
          </div>
        </div>

        <div id="tts-unavailable" style="display: none; padding: 0.75rem 1rem; background: #fef3c7; border-radius: 6px; margin-bottom: 1rem; font-size: 0.85rem; color: #92400e;">
          La synthese vocale n'est pas disponible sur votre navigateur.
        </div>

        {verses.length === 0 ? (
          <p style="color: var(--color-text-muted); padding: 2rem 0;">Aucun verset trouve dans le JSON pour cette sourate.</p>
        ) : (
          verses.map((verse, i) => (
            <div class="verse-review" id={`v${verse.number}`} data-verse={verse.number}>
              <div class="verse-review-header">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                  <span class="verse-num">Verset {verse.number}</span>
                  <span class="verse-vote-badge" id={`badge-${verse.number}`}></span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <button
                    class="tts-verse-btn"
                    id={`tts-btn-${verse.number}`}
                    data-verse={verse.number}
                    title="Ecouter ce verset"
                  >
                    <svg class="tts-icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    <svg class="tts-icon-stop" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>
                  </button>
                  <span class="vote-count" id={`count-${verse.number}`}></span>
                  <button
                    class="report-btn"
                    id={`report-btn-${verse.number}`}
                    data-surah={surahNumber}
                    data-verse={verse.number}
                    title="Signaler une erreur"
                  >
                    Erreur
                  </button>
                  <button
                    class="vote-btn"
                    id={`vote-btn-${verse.number}`}
                    data-surah={surahNumber}
                    data-verse={verse.number}
                    title="Voter pour valider ce verset"
                  >
                    Valider
                  </button>
                </div>
              </div>
              <div class="verse-review-text">
                {verse.text}
              </div>
              <div class="verse-voters" id={`voters-${verse.number}`}></div>
              <!-- Report form (hidden by default) -->
              <div class="report-form" id={`report-form-${verse.number}`} style="display: none;">
                <textarea
                  id={`report-note-${verse.number}`}
                  class="report-textarea"
                  placeholder="Decrivez l'erreur trouvee (ex: faute de traduction, mot manquant, erreur de sens...)"
                  rows="2"
                ></textarea>
                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                  <button class="report-cancel-btn" data-verse={verse.number}>Annuler</button>
                  <button class="report-submit-btn" data-surah={surahNumber} data-verse={verse.number}>Envoyer le signalement</button>
                </div>
              </div>
              <!-- Active reports -->
              <div class="verse-reports" id={`reports-${verse.number}`}></div>
            </div>
          ))
        )}
      </div>
    </div>

    <div style="text-align: center; padding: 2rem 0; display: flex; justify-content: center; gap: 2rem;">
      {prevSurah && <a href={`/admin/review/${prevSurah.slug}/`}>&larr; Sourate {prevSurah.number}</a>}
      <a href="/admin/">Retour a la gestion</a>
      {nextSurah && <a href={`/admin/review/${nextSurah.slug}/`}>Sourate {nextSurah.number} &rarr;</a>}
    </div>
  </div>

  <div id="toast" class="toast"></div>

  <script define:vars={{ surahNumber, totalVerses: verses.length }}>
    let currentUser = null;

    (async () => {
      try {
        const res = await fetch('/api/auth/me');
        if (!res.ok) throw new Error();
        const data = await res.json();
        currentUser = data.user;
      } catch {
        window.location.href = '/admin/login/';
        return;
      }

      // Initialize surah meta for vote tracking
      await fetch('/api/votes/init-surah', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ surah: surahNumber, totalVerses }),
      });

      // Load existing votes and reports
      await Promise.all([loadVotes(), loadReports()]);
    })();

    // ========== EVENT DELEGATION (attached immediately, not after await) ==========
    document.addEventListener('click', (e) => {
      // Vote buttons
      const voteBtn = e.target.closest('.vote-btn');
      if (voteBtn) { handleVote({ currentTarget: voteBtn }); return; }

      // Report toggle
      const reportBtn = e.target.closest('.report-btn');
      if (reportBtn) {
        const verse = reportBtn.dataset.verse;
        const form = document.getElementById('report-form-' + verse);
        if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
        return;
      }

      // Report cancel
      const cancelBtn = e.target.closest('.report-cancel-btn');
      if (cancelBtn) {
        const verse = cancelBtn.dataset.verse;
        const form = document.getElementById('report-form-' + verse);
        const note = document.getElementById('report-note-' + verse);
        if (form) form.style.display = 'none';
        if (note) note.value = '';
        return;
      }

      // Report submit
      const submitBtn = e.target.closest('.report-submit-btn');
      if (submitBtn) { handleSubmitReport({ currentTarget: submitBtn }); return; }

      // Report resolve (dynamically rendered)
      const resolveBtn = e.target.closest('.report-resolve-btn');
      if (resolveBtn) { handleResolveReport({ currentTarget: resolveBtn }); return; }
    });

    async function loadVotes() {
      try {
        const res = await fetch(`/api/votes/surah/${surahNumber}?total=${totalVerses}`);
        if (!res.ok) return;
        const data = await res.json();

        let validatedCount = 0;
        for (let i = 1; i <= totalVerses; i++) {
          const verseData = data.verses[i] || { votes: 0, required: 5, validated: false, hasVoted: false, voters: [] };
          updateVerseUI(i, verseData);
          if (verseData.validated) validatedCount++;
        }

        // Update progress bar
        const pct = totalVerses > 0 ? Math.round((validatedCount / totalVerses) * 100) : 0;
        document.getElementById('progress-bar').style.width = pct + '%';
        document.getElementById('progress-text').textContent = `${validatedCount}/${totalVerses} versets valides (${pct}%)`;

        if (data.surahValidated) {
          document.getElementById('progress-bar').classList.add('complete');
          const badge = document.getElementById('surah-status-badge');
          if (badge) {
            badge.className = 'badge badge-published';
            badge.textContent = 'Validee par vote';
          }
        }
      } catch (e) {
        console.error('Erreur chargement votes:', e);
      }
    }

    function updateVerseUI(verseNum, data) {
      const badge = document.getElementById(`badge-${verseNum}`);
      const count = document.getElementById(`count-${verseNum}`);
      const btn = document.getElementById(`vote-btn-${verseNum}`);
      const votersDiv = document.getElementById(`voters-${verseNum}`);
      const verseEl = document.getElementById(`v${verseNum}`);

      if (!badge || !count || !btn) return;

      // Badge
      if (data.validated) {
        badge.textContent = 'Valide';
        badge.className = 'verse-vote-badge validated';
        verseEl?.classList.add('verse-validated');
      } else if (data.votes > 0) {
        badge.textContent = `${data.votes}/${data.required}`;
        badge.className = 'verse-vote-badge in-progress';
        verseEl?.classList.remove('verse-validated');
      } else {
        badge.textContent = '';
        badge.className = 'verse-vote-badge';
        verseEl?.classList.remove('verse-validated');
      }

      // Count
      count.textContent = `${data.votes}/${data.required}`;

      // Button state
      if (data.hasVoted) {
        btn.textContent = 'Retirer mon vote';
        btn.classList.add('voted');
      } else {
        btn.textContent = 'Valider';
        btn.classList.remove('voted');
      }

      // Voters list
      if (votersDiv && data.voters && data.voters.length > 0) {
        votersDiv.innerHTML = data.voters.map(v =>
          `<span class="voter-chip">${v.name}</span>`
        ).join('');
      } else if (votersDiv) {
        votersDiv.innerHTML = '';
      }
    }

    async function handleVote(e) {
      const btn = e.currentTarget;
      const surah = parseInt(btn.dataset.surah);
      const verse = parseInt(btn.dataset.verse);
      const isRemoving = btn.classList.contains('voted');

      btn.disabled = true;
      btn.textContent = '...';

      try {
        const res = await fetch('/api/votes/cast', {
          method: isRemoving ? 'DELETE' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ surah, verse }),
        });

        const data = await res.json();
        if (!res.ok) {
          showToast(data.error, 'error');
          btn.disabled = false;
          btn.textContent = isRemoving ? 'Retirer mon vote' : 'Valider';
          return;
        }

        updateVerseUI(verse, {
          votes: data.votes,
          required: data.required,
          validated: data.validated,
          hasVoted: !isRemoving,
          voters: data.voters,
        });

        if (data.validated && !isRemoving) {
          showToast(`Verset ${verse} valide !`, 'success');
        }
        if (data.surahValidated) {
          showToast('Sourate entierement validee !', 'success');
        }

        // Reload all votes to update progress bar
        await loadVotes();
      } catch (e) {
        showToast('Erreur de connexion.', 'error');
      }

      btn.disabled = false;
    }

    // ========== ERROR REPORTS ==========
    async function loadReports() {
      try {
        const res = await fetch(`/api/reports/surah/${surahNumber}?total=${totalVerses}`);
        if (!res.ok) return;
        const data = await res.json();

        // Clear all report displays
        for (let i = 1; i <= totalVerses; i++) {
          renderReports(i, data.verses[i] || []);
        }

        // Update error count bar
        const bar = document.getElementById('error-count-bar');
        const text = document.getElementById('error-count-text');
        if (data.totalReports > 0) {
          bar.style.display = 'block';
          text.textContent = `${data.totalReports} erreur(s) signalee(s) sur ${data.versesWithErrors} verset(s)`;
        } else {
          bar.style.display = 'none';
        }
      } catch (e) {
        console.error('Erreur chargement signalements:', e);
      }
    }

    function renderReports(verseNum, reports) {
      const container = document.getElementById(`reports-${verseNum}`);
      const reportBtn = document.getElementById(`report-btn-${verseNum}`);
      const verseEl = document.getElementById(`v${verseNum}`);
      if (!container) return;

      if (reports.length === 0) {
        container.innerHTML = '';
        reportBtn?.classList.remove('has-reports');
        verseEl?.classList.remove('verse-has-error');
        return;
      }

      reportBtn?.classList.add('has-reports');
      verseEl?.classList.add('verse-has-error');

      container.innerHTML = `
        <div class="reports-header">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          ${reports.length} erreur(s) signalee(s)
        </div>
        ${reports.map(r => `
          <div class="report-item" data-report-id="${r.id}">
            <div class="report-item-header">
              <span class="report-author">${r.name}</span>
              <span class="report-date">${new Date(r.date).toLocaleDateString('fr-FR')}</span>
            </div>
            <div class="report-note">${r.note}</div>
            <button class="report-resolve-btn" data-surah="${surahNumber}" data-verse="${verseNum}" data-report-id="${r.id}">
              Marquer comme resolu
            </button>
          </div>
        `).join('')}
      `;

      // Resolve handlers are managed by event delegation on document
    }

    async function handleSubmitReport(e) {
      const btn = e.currentTarget;
      const surah = parseInt(btn.dataset.surah);
      const verse = parseInt(btn.dataset.verse);
      const noteEl = document.getElementById(`report-note-${verse}`);
      const note = noteEl.value.trim();

      if (!note) {
        showToast('Veuillez decrire l\'erreur.', 'error');
        return;
      }

      btn.disabled = true;
      btn.textContent = '...';

      try {
        const res = await fetch('/api/reports/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ surah, verse, note }),
        });

        const data = await res.json();
        if (!res.ok) {
          showToast(data.error, 'error');
        } else {
          showToast('Erreur signalee.', 'success');
          noteEl.value = '';
          document.getElementById(`report-form-${verse}`).style.display = 'none';
          await loadReports();
        }
      } catch {
        showToast('Erreur de connexion.', 'error');
      }

      btn.disabled = false;
      btn.textContent = 'Envoyer le signalement';
    }

    async function handleResolveReport(e) {
      const btn = e.currentTarget;
      const surah = parseInt(btn.dataset.surah);
      const verse = parseInt(btn.dataset.verse);
      const reportId = btn.dataset.reportId;

      btn.disabled = true;
      btn.textContent = '...';

      try {
        const res = await fetch('/api/reports/resolve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ surah, verse, reportId }),
        });

        if (res.ok) {
          showToast('Signalement resolu.', 'success');
          await loadReports();
        }
      } catch {
        showToast('Erreur de connexion.', 'error');
      }
    }

    function showToast(message, type) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.className = `toast show ${type}`;
      setTimeout(() => toast.className = 'toast', 3000);
    }

    // ========== TEXT-TO-SPEECH (Workers AI + browser fallback) ==========
    const synth = window.speechSynthesis;
    let ttsPlaying = false;
    let ttsCurrentVerse = null;
    let ttsPlayAllMode = false;
    let ttsPlayAllIndex = 0;
    let currentAudio = null; // For Workers AI audio playback
    let useWorkersAI = true; // Try Workers AI first, fallback to browser
    let frenchVoice = null;

    // Load browser voices as fallback
    function loadVoices() {
      if (!synth) return;
      const voices = synth.getVoices();
      frenchVoice = voices.find(v => v.lang.startsWith('fr') && v.name.toLowerCase().includes('natural'))
        || voices.find(v => v.lang.startsWith('fr') && v.name.toLowerCase().includes('enhanced'))
        || voices.find(v => v.lang.startsWith('fr') && !v.localService)
        || voices.find(v => v.lang.startsWith('fr'))
        || null;
    }
    loadVoices();
    if (synth && synth.onvoiceschanged !== undefined) {
      synth.onvoiceschanged = loadVoices;
    }

    function getSpeed() {
      return parseFloat(document.getElementById('tts-speed').value) || 1;
    }

    function stopTTS() {
      // Stop Workers AI audio
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
        currentAudio = null;
      }
      // Stop browser TTS
      if (synth) synth.cancel();
      ttsPlaying = false;
      ttsPlayAllMode = false;
      resetAllTTSButtons();
      removeTextHighlight();
      updatePlayAllBtn(false);
    }

    function resetAllTTSButtons() {
      document.querySelectorAll('.tts-verse-btn').forEach(btn => {
        btn.classList.remove('playing', 'loading');
        btn.querySelector('.tts-icon-play').style.display = '';
        btn.querySelector('.tts-icon-stop').style.display = 'none';
      });
    }

    function setVerseBtnPlaying(verseNum, state) {
      const btn = document.getElementById(`tts-btn-${verseNum}`);
      if (!btn) return;
      btn.classList.remove('playing', 'loading');
      if (state === 'playing') {
        btn.classList.add('playing');
        btn.querySelector('.tts-icon-play').style.display = 'none';
        btn.querySelector('.tts-icon-stop').style.display = '';
      } else if (state === 'loading') {
        btn.classList.add('loading');
        btn.querySelector('.tts-icon-play').style.display = 'none';
        btn.querySelector('.tts-icon-stop').style.display = '';
      } else {
        btn.querySelector('.tts-icon-play').style.display = '';
        btn.querySelector('.tts-icon-stop').style.display = 'none';
      }
    }

    function updatePlayAllBtn(playing) {
      const btn = document.getElementById('tts-play-all');
      if (!btn) return;
      if (playing) {
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="1"/></svg> Arreter';
        btn.classList.add('playing');
      } else {
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> Tout ecouter';
        btn.classList.remove('playing');
      }
    }

    function highlightVerse(verseNum) {
      removeTextHighlight();
      const el = document.getElementById(`v${verseNum}`);
      if (el) {
        el.classList.add('verse-speaking');
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function removeTextHighlight() {
      document.querySelectorAll('.verse-speaking').forEach(el => el.classList.remove('verse-speaking'));
    }

    function onVerseEnd(verseNum) {
      setVerseBtnPlaying(verseNum, 'stopped');
      removeTextHighlight();
      ttsPlaying = false;
      ttsCurrentVerse = null;

      if (ttsPlayAllMode) {
        ttsPlayAllIndex++;
        const allVerseEls = document.querySelectorAll('.verse-review[data-verse]');
        if (ttsPlayAllIndex < allVerseEls.length) {
          const nextVerse = parseInt(allVerseEls[ttsPlayAllIndex].dataset.verse);
          speakVerse(nextVerse);
        } else {
          ttsPlayAllMode = false;
          updatePlayAllBtn(false);
        }
      }
    }

    function onVerseError(verseNum) {
      setVerseBtnPlaying(verseNum, 'stopped');
      removeTextHighlight();
      ttsPlaying = false;
      ttsCurrentVerse = null;
      ttsPlayAllMode = false;
      updatePlayAllBtn(false);
    }

    // ---- Workers AI TTS (natural voice via MeloTTS) ----
    const audioCache = {};

    async function speakVerseAI(verseNum, text) {
      ttsPlaying = true;
      ttsCurrentVerse = verseNum;
      setVerseBtnPlaying(verseNum, 'loading');
      highlightVerse(verseNum);

      try {
        let audioUrl = audioCache[`${surahNumber}:${verseNum}`];

        if (!audioUrl) {
          const res = await fetch('/api/tts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text }),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            if (err.fallback) {
              // Workers AI unavailable, switch to browser TTS
              useWorkersAI = false;
              showToast('Voix IA indisponible, utilisation de la voix navigateur.', 'error');
              speakVerseBrowser(verseNum, text);
              return;
            }
            throw new Error(err.error || 'Erreur TTS');
          }

          const blob = await res.blob();
          audioUrl = URL.createObjectURL(blob);
          audioCache[`${surahNumber}:${verseNum}`] = audioUrl;
        }

        if (currentAudio) {
          currentAudio.pause();
          currentAudio = null;
        }

        const audio = new Audio(audioUrl);
        audio.playbackRate = getSpeed();
        currentAudio = audio;

        setVerseBtnPlaying(verseNum, 'playing');

        audio.onended = () => {
          currentAudio = null;
          onVerseEnd(verseNum);
        };
        audio.onerror = () => {
          currentAudio = null;
          onVerseError(verseNum);
        };

        await audio.play();
      } catch (e) {
        console.error('Workers AI TTS error:', e);
        // Fallback to browser TTS
        useWorkersAI = false;
        showToast('Voix IA indisponible, utilisation de la voix navigateur.', 'error');
        speakVerseBrowser(verseNum, text);
      }
    }

    // ---- Browser TTS fallback ----
    function speakVerseBrowser(verseNum, text) {
      if (!synth) {
        document.getElementById('tts-unavailable').style.display = 'block';
        onVerseError(verseNum);
        return;
      }

      synth.cancel();
      resetAllTTSButtons();

      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'fr-FR';
      utterance.rate = getSpeed();
      utterance.pitch = 1;
      if (frenchVoice) utterance.voice = frenchVoice;

      ttsPlaying = true;
      ttsCurrentVerse = verseNum;
      setVerseBtnPlaying(verseNum, 'playing');
      highlightVerse(verseNum);

      utterance.onend = () => onVerseEnd(verseNum);
      utterance.onerror = () => onVerseError(verseNum);

      // Chrome workaround for long texts
      let resumeInterval = null;
      utterance.onstart = () => {
        resumeInterval = setInterval(() => {
          if (synth.speaking && !synth.paused) {
            synth.pause();
            synth.resume();
          }
        }, 10000);
      };
      const origOnEnd = utterance.onend;
      utterance.onend = (e) => { clearInterval(resumeInterval); origOnEnd(e); };
      const origOnError = utterance.onerror;
      utterance.onerror = (e) => { clearInterval(resumeInterval); origOnError(e); };

      synth.speak(utterance);
    }

    // ---- Main speak function (picks AI or browser) ----
    function speakVerse(verseNum) {
      const textEl = document.querySelector(`#v${verseNum} .verse-review-text`);
      if (!textEl) return;
      const text = textEl.textContent.trim();
      if (!text) return;

      stopTTS();

      if (useWorkersAI) {
        speakVerseAI(verseNum, text);
      } else {
        speakVerseBrowser(verseNum, text);
      }
    }

    // Per-verse play/stop buttons
    document.querySelectorAll('.tts-verse-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const verseNum = parseInt(btn.dataset.verse);
        if (ttsPlaying && ttsCurrentVerse === verseNum) {
          stopTTS();
        } else {
          ttsPlayAllMode = false;
          updatePlayAllBtn(false);
          speakVerse(verseNum);
        }
      });
    });

    // "Play all" button
    document.getElementById('tts-play-all')?.addEventListener('click', () => {
      if (ttsPlayAllMode || ttsPlaying) {
        stopTTS();
        return;
      }
      const allVerseEls = document.querySelectorAll('.verse-review[data-verse]');
      if (allVerseEls.length === 0) return;
      ttsPlayAllMode = true;
      ttsPlayAllIndex = 0;
      updatePlayAllBtn(true);
      const firstVerse = parseInt(allVerseEls[0].dataset.verse);
      speakVerse(firstVerse);
    });

    // Speed change applies to current playback
    document.getElementById('tts-speed')?.addEventListener('change', () => {
      const speed = getSpeed();
      // If Workers AI audio is playing, adjust playback rate directly
      if (currentAudio && ttsPlaying) {
        currentAudio.playbackRate = speed;
      }
      // If browser TTS is playing, restart at new speed
      if (!currentAudio && ttsPlaying && ttsCurrentVerse && synth.speaking) {
        const v = ttsCurrentVerse;
        const wasPlayAll = ttsPlayAllMode;
        const wasIndex = ttsPlayAllIndex;
        synth.cancel();
        ttsPlayAllMode = wasPlayAll;
        ttsPlayAllIndex = wasIndex;
        speakVerseBrowser(v, document.querySelector(`#v${v} .verse-review-text`)?.textContent?.trim());
      }
    });

    // Stop TTS when leaving the page
    window.addEventListener('beforeunload', () => {
      if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      if (synth) synth.cancel();
    });
  </script>
</BaseLayout>

