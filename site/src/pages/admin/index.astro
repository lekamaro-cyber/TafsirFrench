---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSurahsByStatus, getAllSurahs } from '../../lib/content.js';

const groups = getSurahsByStatus();
const all = getAllSurahs();
---

<BaseLayout title="Gestion du contenu">
  <div class="container-wide">
    <div class="admin-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h1>Gestion du contenu</h1>
        <p style="color: var(--color-text-muted); margin-top: 0.25rem;">
        Relecture, validation et planification de la publication &mdash; {all.length} sourates, 6236 versets
        </p>
      </div>
      <div id="user-bar" style="display: none; align-items: center; gap: 0.75rem; font-size: 0.9rem;">
        <span id="user-role-badge" class="role-badge" style="display:none;"></span>
        <span id="user-name" style="color: var(--color-text-muted);"></span>
        <button id="logout-btn" style="padding: 0.4rem 0.8rem; border: 1px solid var(--color-border); border-radius: 6px; background: none; cursor: pointer; font-size: 0.85rem;">
          Deconnexion
        </button>
      </div>
    </div>

    <!-- Stats -->
    <div class="admin-stats">
      <div class="stat-card">
        <div class="count" style="color: var(--color-draft);">{groups.draft.length}</div>
        <div class="label">Brouillons</div>
      </div>
      <div class="stat-card">
        <div class="count" style="color: var(--color-review);">{groups.review.length}</div>
        <div class="label">En relecture</div>
      </div>
      <div class="stat-card">
        <div class="count" style="color: var(--color-scheduled);">{groups.scheduled.length}</div>
        <div class="label">Planifiees</div>
      </div>
      <div class="stat-card">
        <div class="count" style="color: var(--color-published);">{groups.published.length}</div>
        <div class="label">Publiees</div>
      </div>
    </div>

    <!-- Vote validation progress -->
    <div class="admin-section">
      <h2>Validation collaborative</h2>
      <p style="font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1rem;">
        Chaque verset necessite 5 votes pour etre valide. Une fois tous les versets valides, la sourate est automatiquement validee.
      </p>
      <div id="vote-progress-container" style="color: var(--color-text-muted); font-size: 0.9rem;">
        Chargement des donnees de vote...
      </div>
    </div>

    <!-- Admin navigation -->
    <div id="admin-nav" style="display: none; margin: 1rem 0; display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <a href="/admin/corrections/" class="nav-card">
        <strong>Corrections</strong>
        <span>Voir les corrections en attente</span>
      </a>
      <a href="/admin/users/" id="nav-users" class="nav-card" style="display: none;">
        <strong>Utilisateurs</strong>
        <span>Gerer les roles et les acces</span>
      </a>
      <button id="nav-export" class="nav-card" style="display: none; cursor: pointer; background: none; text-align: left;">
        <strong>Telecharger le JSON</strong>
        <span>Exporter le tafsir avec corrections appliquees</span>
      </button>
    </div>

    <!-- Instructions -->
    <div style="margin: 1rem 0; padding: 1rem 1.25rem; background: #fefce8; border-radius: 8px; font-size: 0.9rem; border: 1px solid #fef08a;">
      <strong>Workflow :</strong> Les sourates sont validees par le vote collaboratif des relecteurs.
      Chaque verset necessite 5 votes. Les correcteurs peuvent proposer des modifications de texte,
      qui doivent etre approuvees par 2 relecteurs/admins avant d'etre appliquees.
    </div>

    <!-- En relecture -->
    {groups.review.length > 0 && (
      <div class="admin-section">
        <h2>En attente de relecture ({groups.review.length})</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>N</th>
              <th>Sourate</th>
              <th>Arabe</th>
              <th>Versets</th>
              <th>Validation</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {groups.review.map(s => (
              <tr>
                <td>{s.number}</td>
                <td>{s.name_fr}</td>
                <td style="font-family: var(--font-arabic); direction: rtl;">{s.name_ar}</td>
                <td>{s.tafsirVerseCount}/{s.verses}</td>
                <td><span class="vote-progress-cell" data-surah={s.number}>-</span></td>
                <td><span class="badge badge-review">Relecture</span></td>
                <td><a href={`/admin/review/${s.slug}/`}>Relire & voter</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Brouillons -->
    {groups.draft.length > 0 && (
      <div class="admin-section">
        <h2>Brouillons ({groups.draft.length})</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>N</th>
              <th>Sourate</th>
              <th>Arabe</th>
              <th>Versets tafsir</th>
              <th>Validation</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {groups.draft.map(s => (
              <tr>
                <td>{s.number}</td>
                <td>{s.name_fr}</td>
                <td style="font-family: var(--font-arabic); direction: rtl;">{s.name_ar}</td>
                <td>{s.tafsirVerseCount}/{s.verses}</td>
                <td><span class="vote-progress-cell" data-surah={s.number}>-</span></td>
                <td><span class="badge badge-draft">Brouillon</span></td>
                <td><a href={`/admin/review/${s.slug}/`}>Voir & voter</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Planifiees -->
    {groups.scheduled.length > 0 && (
      <div class="admin-section">
        <h2>Publication planifiee ({groups.scheduled.length})</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>N</th>
              <th>Sourate</th>
              <th>Date de publication</th>
              <th>Relecteur</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {groups.scheduled.map(s => (
              <tr>
                <td>{s.number}</td>
                <td>{s.name_fr}</td>
                <td>{s.publish_date || '-'}</td>
                <td>{s.reviewer || '-'}</td>
                <td><span class="badge badge-scheduled">Planifiee</span></td>
                <td><a href={`/admin/review/${s.slug}/`}>Voir</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Publiees -->
    {groups.published.length > 0 && (
      <div class="admin-section">
        <h2>Publiees ({groups.published.length})</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>N</th>
              <th>Sourate</th>
              <th>Date</th>
              <th>Lien</th>
            </tr>
          </thead>
          <tbody>
            {groups.published.map(s => (
              <tr>
                <td>{s.number}</td>
                <td>{s.name_fr}</td>
                <td>{s.publish_date || '-'}</td>
                <td><a href={`/surahs/${s.slug}/`}>Voir sur le site</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <script>
    (async () => {
      try {
        const res = await fetch('/api/auth/me');
        if (!res.ok) throw new Error();
        const { user } = await res.json();
        document.getElementById('user-name').textContent = user.name;
        document.getElementById('user-bar').style.display = 'flex';

        // Show role badge
        const roleLabels = { admin: 'Administrateur', relecteur: 'Relecteur', correcteur: 'Correcteur' };
        const badge = document.getElementById('user-role-badge');
        badge.textContent = roleLabels[user.role] || user.role;
        badge.className = 'role-badge role-' + user.role;
        badge.style.display = 'inline-block';

        // Show admin nav
        document.getElementById('admin-nav').style.display = 'flex';
        if (user.role === 'admin') {
          document.getElementById('nav-users').style.display = 'block';
          document.getElementById('nav-export').style.display = 'flex';
        }
      } catch {
        window.location.href = '/admin/login/';
        return;
      }

      // Load vote summary
      try {
        const res = await fetch('/api/votes/summary');
        if (res.ok) {
          const { summary } = await res.json();
          const container = document.getElementById('vote-progress-container');

          const entries = Object.entries(summary);
          if (entries.length === 0) {
            container.innerHTML = '<p style="color: var(--color-text-muted);">Aucun vote enregistre pour le moment. Commencez par relire les sourates et voter sur les versets.</p>';
          } else {
            let totalValidated = 0;
            let totalVerses = 0;
            let completedSurahs = 0;

            entries.forEach(([num, data]) => {
              totalValidated += data.validatedCount || 0;
              totalVerses += data.totalVerses || 0;
              if (data.completed) completedSurahs++;
            });

            const pct = totalVerses > 0 ? Math.round((totalValidated / totalVerses) * 100) : 0;

            container.innerHTML = `
              <div style="display: flex; gap: 1.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
                <div class="stat-card" style="flex: 1; min-width: 120px;">
                  <div class="count" style="color: var(--color-primary);">${totalValidated}</div>
                  <div class="label">Versets valides</div>
                </div>
                <div class="stat-card" style="flex: 1; min-width: 120px;">
                  <div class="count" style="color: var(--color-published);">${completedSurahs}</div>
                  <div class="label">Sourates validees</div>
                </div>
                <div class="stat-card" style="flex: 1; min-width: 120px;">
                  <div class="count" style="color: var(--color-review);">${entries.length}</div>
                  <div class="label">Sourates en cours</div>
                </div>
              </div>
              <div style="margin-bottom: 0.5rem; display: flex; justify-content: space-between;">
                <span>Progression globale</span>
                <span>${totalValidated}/${totalVerses} versets (${pct}%)</span>
              </div>
              <div style="width: 100%; height: 8px; background: var(--color-border); border-radius: 100px; overflow: hidden;">
                <div style="height: 100%; width: ${pct}%; background: var(--color-primary); border-radius: 100px; transition: width 0.5s;"></div>
              </div>
            `;

            // Update per-surah cells
            document.querySelectorAll('.vote-progress-cell').forEach(cell => {
              const surahNum = cell.dataset.surah;
              const data = summary[surahNum];
              if (data) {
                const sp = Math.round((data.validatedCount / data.totalVerses) * 100);
                cell.innerHTML = `<span style="font-size: 0.8rem;">${data.validatedCount}/${data.totalVerses} (${sp}%)</span>`;
                if (data.completed) {
                  cell.innerHTML = '<span class="badge badge-published" style="font-size: 0.7rem;">Validee</span>';
                }
              }
            });
          }
        }
      } catch (e) {
        console.error('Erreur chargement votes:', e);
      }
    })();
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/admin/login/';
    });

    document.getElementById('nav-export')?.addEventListener('click', async () => {
      const btn = document.getElementById('nav-export');
      btn.querySelector('span').textContent = 'Telechargement en cours...';
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/export-json');
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          alert(err.error || 'Erreur lors de l\'export.');
          return;
        }
        const applied = res.headers.get('X-Corrections-Applied') || '0';
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'tafsir_fr_corrige.json';
        a.click();
        URL.revokeObjectURL(url);
        btn.querySelector('span').textContent = `Exporte (${applied} correction(s) appliquee(s))`;
      } catch {
        alert('Erreur de connexion.');
      } finally {
        btn.disabled = false;
        setTimeout(() => {
          btn.querySelector('span').textContent = 'Exporter le tafsir avec corrections appliquees';
        }, 3000);
      }
    });
  </script>

  <style>
    .role-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 100px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .role-admin { background: #fef3c7; color: #92400e; }
    .role-relecteur { background: #dbeafe; color: #1e40af; }
    .role-correcteur { background: #d1fae5; color: #065f46; }
    .nav-card {
      display: flex;
      flex-direction: column;
      padding: 0.75rem 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .nav-card:hover {
      border-color: var(--color-primary);
      box-shadow: 0 2px 8px rgba(37, 99, 235, 0.1);
    }
    .nav-card strong { font-size: 0.95rem; }
    .nav-card span { font-size: 0.8rem; color: var(--color-text-muted); }
  </style>
</BaseLayout>
