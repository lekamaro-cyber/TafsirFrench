---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllSurahs } from '../lib/content.js';

const surahs = getAllSurahs();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Tafsir en Francais",
  "url": "https://tafsir-french.org",
  "description": "Tafsir du Coran en langue francaise - Exegese et commentaire (Ibn Kathir). Projet collaboratif de relecture et correction.",
  "inLanguage": "fr",
};
---

<BaseLayout title="Accueil" description="Tafsir du Coran en langue francaise - Exegese et commentaire d'Ibn Kathir. Projet collaboratif de relecture, correction et publication des 114 sourates." jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <h1>Tafsir du Coran en Francais</h1>
      <p>Exegese et commentaire du Saint Coran - Ibn Kathir</p>
    </div>
  </section>

  <!-- Section Participer -->
  <section class="participate-section">
    <div class="container">
      <h2 class="participate-title">Comment participer ?</h2>
      <p class="participate-intro">
        Ce projet est collaboratif. Chaque contribution compte pour offrir un tafsir
        de qualite en langue francaise. Voici la demarche pour nous rejoindre et
        participer a la completion des textes.
      </p>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>Creer un compte</h3>
          <p>
            Inscrivez-vous sur la plateforme via la page
            <a href="/admin/login/">connexion</a>. Vous recevrez le role
            de <strong>Relecteur</strong> par defaut.
          </p>
        </div>

        <div class="step-card">
          <div class="step-number">2</div>
          <h3>Relire et valider</h3>
          <p>
            Parcourez les sourates en relecture, lisez chaque verset et son tafsir,
            puis votez pour valider les passages corrects.
            Un verset n'est considere comme valide qu'apres
            <strong>5 validations</strong> de relecteurs differents.
          </p>
        </div>

        <div class="step-card">
          <div class="step-number">3</div>
          <h3>Signaler les erreurs</h3>
          <p>
            Si vous repérez une erreur de traduction ou de contenu, utilisez le
            bouton <strong>"Erreur"</strong> pour la signaler. Chaque signalement
            est examine par l'equipe.
          </p>
        </div>

        <div class="step-card">
          <div class="step-number">4</div>
          <h3>Proposer des corrections</h3>
          <p>
            Demandez le role de <strong>Correcteur</strong> pour proposer
            directement des modifications de texte. Une correction est
            appliquee si un <strong>administrateur</strong> la valide,
            ou apres approbation de <strong>2 relecteurs</strong>.
          </p>
        </div>
      </div>

      <!-- Roles -->
      <div class="roles-section">
        <h3 class="roles-title">Les roles</h3>
        <div class="roles-grid">
          <div class="role-card">
            <div class="role-icon role-relecteur">R</div>
            <div class="role-info">
              <strong>Relecteur</strong>
              <p>Vote sur les versets, approuve les corrections, signale les erreurs</p>
            </div>
          </div>
          <div class="role-card">
            <div class="role-icon role-correcteur">C</div>
            <div class="role-info">
              <strong>Correcteur</strong>
              <p>Propose des modifications de texte en plus des droits de relecteur</p>
            </div>
          </div>
          <div class="role-card">
            <div class="role-icon role-admin">A</div>
            <div class="role-info">
              <strong>Administrateur</strong>
              <p>Applique les corrections, gere les utilisateurs et publie le contenu</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Call to action -->
      <div class="cta-section">
        <p>Pret a contribuer a ce projet ?</p>
        <a href="/admin/login/" class="cta-button">Rejoindre le projet</a>
      </div>
    </div>
  </section>

  <!-- Sourates publiees -->
  <div class="container">
    <div id="surahs-loading" style="text-align: center; padding: 3rem 0; color: var(--color-text-muted);">
      <p style="font-size: 1.2rem;">Chargement des sourates publiees...</p>
    </div>
    <div id="surahs-empty" style="text-align: center; padding: 3rem 0; color: var(--color-text-muted); display: none;">
      <p style="font-size: 1.2rem;">Aucune sourate publiee pour le moment.</p>
      <p style="margin-top: 0.5rem;">
        <a href="/admin/">Acceder au panneau de gestion</a> pour relire et publier le contenu.
      </p>
    </div>
    <h2 class="section-title" id="surahs-title" style="display: none;">Sourates publiees</h2>
    <div class="surah-grid">
      {surahs.map(surah => (
        <a href={`/surahs/${surah.slug}/`} class="surah-card" data-surah={surah.number} style="text-decoration: none; color: inherit; display: none;">
          <span class="number">{surah.number}</span>
          <h3>{surah.name_fr}</h3>
          <div class="name-ar">{surah.name_ar}</div>
          <div class="meta">
            {surah.verses} versets &middot; {surah.type}
          </div>
        </a>
      ))}
    </div>
  </div>
  <script>
    async function loadPublishedSurahs() {
      const loadingEl = document.getElementById('surahs-loading');
      const emptyEl = document.getElementById('surahs-empty');
      const titleEl = document.getElementById('surahs-title');
      try {
        const res = await fetch('/api/published-surahs');
        if (!res.ok) throw new Error('Erreur API');
        const data = await res.json();
        const published = data.surahs || [];

        loadingEl.style.display = 'none';

        if (published.length === 0) {
          emptyEl.style.display = '';
          return;
        }

        titleEl.style.display = '';
        const cards = document.querySelectorAll('.surah-card[data-surah]');
        cards.forEach(card => {
          const num = parseInt(card.getAttribute('data-surah'));
          if (published.includes(num)) {
            card.style.display = '';
          }
        });
      } catch (err) {
        loadingEl.textContent = 'Erreur lors du chargement des sourates.';
      }
    }
    loadPublishedSurahs();
  </script>
</BaseLayout>
