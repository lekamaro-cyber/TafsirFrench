---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedSurahs, getSurahMeta, getSurahTafsir } from '../../lib/content.js';

export function getStaticPaths() {
  const surahs = getPublishedSurahs();
  return surahs.map(s => ({
    params: { slug: s.slug },
    props: { surahNumber: s.number },
  }));
}

const { surahNumber } = Astro.props;
const meta = getSurahMeta(surahNumber);
const verses = getSurahTafsir(surahNumber);
---

<BaseLayout title={`${meta.name_fr} - ${meta.name_ar}`}>
  <div class="container">
    <div class="surah-header">
      <div class="name-ar">{meta.name_ar}</div>
      <h1>{meta.name_fr}</h1>
      <p class="info">
        Sourate {meta.number} &middot;
        {meta.verses} versets &middot;
        Revelation {meta.type}
      </p>
    </div>

    {verses.map(verse => (
      <div class="verse-section">
        <h2>Verset {verse.number}</h2>
        <p>{verse.text}</p>
      </div>
    ))}

    <div style="text-align: center; padding: 2rem 0;">
      <a href="/surahs/">&larr; Retour aux sourates</a>
    </div>
  </div>
</BaseLayout>
