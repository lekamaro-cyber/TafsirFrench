---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedSurahs, getSurah, parseVerses } from '../../lib/content.js';

export function getStaticPaths() {
  const surahs = getPublishedSurahs();
  return surahs.map(s => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const surah = getSurah(slug);

if (!surah) {
  return Astro.redirect('/404');
}

const verses = parseVerses(surah.rawContent);
const { frontmatter } = surah;
---

<BaseLayout title={`${frontmatter.name_fr} - ${frontmatter.name_ar}`}>
  <div class="container">
    <div class="surah-header">
      <div class="name-ar">{frontmatter.name_ar}</div>
      <h1>{frontmatter.name_fr}</h1>
      <p class="info">
        Sourate {frontmatter.number} &middot;
        {frontmatter.verses_count} versets &middot;
        Revelation {frontmatter.revelation_type}
      </p>
    </div>

    {verses.map(verse => (
      <div class="verse-section">
        <h2>Verset {verse.number}</h2>
        <Fragment set:html={verse.html} />
      </div>
    ))}

    <div style="text-align: center; padding: 2rem 0;">
      <a href="/surahs/">&larr; Retour aux sourates</a>
    </div>
  </div>
</BaseLayout>
